# PostgreSQL connection string (required). No default — the service fails fast if unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/token_management

# HTTP port the service listens on.
PORT=3000

# Base path under which all business routes (F02+) are mounted. /health is mounted at root.
API_BASE_PATH=/api

# Fixed size of the token pool. Read once at startup and immutable for the process lifetime.
POOL_SIZE=100

# Time-to-live for an active token, in seconds (consumed by F03).
TOKEN_TTL_SECONDS=120
